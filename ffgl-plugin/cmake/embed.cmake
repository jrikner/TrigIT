# Writes OUT: a C++ header holding each NAME=PATH Lua module as a byte array.
set(text "// Generated by cmake/embed.cmake: edit the .lua files, not this.\n#pragma once\n#include <cstddef>\n")
set(table "")
foreach(module IN LISTS MODULES)
    string(REPLACE "=" ";" pair "${module}")
    list(GET pair 0 name)
    list(GET pair 1 path)
    file(READ "${path}" hex HEX)
    string(REGEX REPLACE "(..)" "0x\\1," bytes "${hex}")
    string(APPEND text "static const unsigned char lua_${name}[] = {${bytes}};\n")
    string(APPEND table "    {\"${name}\", lua_${name}, sizeof lua_${name}},\n")
endforeach()
string(APPEND text "struct EmbeddedLua { const char* name; const unsigned char* data; std::size_t size; };\n")
string(APPEND text "static const EmbeddedLua embeddedLua[] = {\n${table}};\n")
file(WRITE "${OUT}" "${text}")
